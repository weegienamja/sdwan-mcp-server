{
  "name": "cisco-vmanage-mcp",
  "displayName": "Cisco vManage MCP",
  "description": "Read-only Cisco SD-WAN vManage inventory, health, correlation, and incident diagnostics",
  "version": "2.2.0",
  "license": "Apache-2.0",
  "repository": "https://wwwin-github.cisco.com/jamiblai/sdwan-mcp-server",
  "command": "python",
  "args": ["-m", "cisco_vmanage_mcp"],
  "type": "stdio",
  "env": {
    "VMANAGE_HOST": "${input:vmanage_host}",
    "VMANAGE_PORT": "${input:vmanage_port}",
    "VMANAGE_USERNAME": "${input:vmanage_username}",
    "VMANAGE_PASSWORD": "${input:vmanage_password}",
    "VMANAGE_VERIFY_SSL": "${input:vmanage_verify_ssl}"
  }
}
