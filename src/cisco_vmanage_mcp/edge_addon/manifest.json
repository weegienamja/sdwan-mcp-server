{
  "manifest_version": 3,
  "name": "SD-WAN Workstation",
  "description": "Diagnose the signed-in Cisco Manager estate with local Qwen.",
  "version": "1.0.0",
  "key": "",
  "permissions": ["activeTab", "scripting", "nativeMessaging"],
  "action": {"default_title": "Diagnose with local Qwen"},
  "commands": {"_execute_action": {"suggested_key": {"default": "Alt+Shift+Q"}}},
  "background": {"service_worker": "action.js"},
  "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'none'; connect-src 'self'; base-uri 'none'"}
}
