{
  "manifest_version": 3,
  "name": "BlairScope",
  "description": "Read-only SD-WAN diagnostics with local Qwen for your work estate and Cisco DevNet lab. By Jamie Blair.",
  "version": "2.1.0",
  "incognito": "split",
  "minimum_chrome_version": "116",
  "key": "",
  "permissions": ["activeTab", "scripting", "nativeMessaging", "sidePanel"],
  "icons": {"16": "icon16.png", "32": "icon32.png", "48": "icon48.png", "128": "icon128.png"},
  "action": {"default_title": "BlairScope · Diagnose with local Qwen"},
  "side_panel": {"default_path": "diagnose.html"},
  "commands": {"_execute_action": {"suggested_key": {"default": "Alt+Shift+Q"}}},
  "background": {"service_worker": "action.js"},
  "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'none'; connect-src 'self'; base-uri 'none'"}
}
