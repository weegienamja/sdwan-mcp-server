# Cisco DevNet always-on SD-WAN sandbox
# Credentials: https://devnetsandbox.cisco.com/DevNet/catalog/sd-wan-20-10
VMANAGE_HOST=sandbox-sdwan-2.cisco.com
VMANAGE_PORT=443
VMANAGE_USERNAME=your_username
VMANAGE_PASSWORD=your_password
VMANAGE_VERIFY_SSL=true
VMANAGE_MAX_RETRIES=3

# Optional private CA bundle. Keep verification enabled when using this.
# VMANAGE_CA_BUNDLE=/path/to/private-ca-bundle.pem

# Optional rotating JSONL audit log.
# AUDIT_LOG_PATH=~/.vmanage-mcp/audit.jsonl
# AUDIT_STDERR=false

# Optional minimal Splunk telemetry (tool, random installation ID, timing, result).
# VMANAGE_MCP_TELEMETRY=false
# SPLUNK_HEC_URL=https://splunk.example.test:8088/services/collector
# SPLUNK_HEC_TOKEN=your_hec_token

# Optional Cisco IDE telemetry. Review README privacy details before enabling.
# VMANAGE_MCP_IDE_TELEMETRY=false
# IDE_MCP_MARKETPLACE_ID=your_marketplace_id

# Optional AI-provider TLS interception bundle: a path or the packaged "bundled" set.
# AI_CA_BUNDLE=bundled
